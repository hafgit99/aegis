{
  "name": "aegis-vault",
  "version": "1.1.1",
  "type": "module",
  "description": "Premium, Offline-First, Zero-Knowledge Password Manager - Security Hardened Edition",
  "main": "main.js",
  "author": "Aegis Security",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "start": "npx electron .",
    "build": "npx vite build && npx electron-builder build --win",
    "postbuild": "powershell -Command \"$out = 'dist_electron'; if (Test-Path $out) { Remove-Item -Path (Join-Path $out 'SHA256SUMS.txt') -ErrorAction SilentlyContinue; Get-ChildItem -Path $out -Filter '*.zip' | ForEach-Object { $hash = (Get-FileHash $_.FullName -Algorithm SHA256).Hash; \\\"$hash  $($_.Name)\\\" | Out-File (Join-Path $out 'SHA256SUMS.txt') -Append -Encoding utf8; Write-Host \\\"[Security] Checksum created for $($_.Name)\\\" } }\"",
    "rebuild-native": "electron-rebuild -f -w aegis_security"
  },
  "dependencies": {
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "dexie": "^4.0.0",
    "framer-motion": "^11.0.0",
    "hash-wasm": "^4.11.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    "lucide-react": "^0.400.0",
    "papaparse": "^5.5.3",
    "qrcode": "^1.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/html2canvas": "^0.5.35",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-icon-builder": "^2.0.1",
    "electron-rebuild": "^3.2.9",
    "keytar": "^7.9.0",
    "node-addon-api": "^8.0.0",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.18",
    "vite": "^7.3.0",
    "webpack-cli": "^6.0.1"
  },
  "build": {
    "appId": "com.aegis.vault",
    "productName": "Aegis Vault",
    "copyright": "Copyright © 2024 Aegis Security",
    "directories": {
      "output": "dist_electron",
      "buildResources": "build/icons"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.cjs",
      "preload.js",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "icon": "build/icons/icons/icon.ico",
      "publisherName": "Aegis Security",
      "verifyUpdateCodeSignature": true,
      "forceCodeSigning": false,
      "certificateFile": null,
      "certificatePassword": null,
      "signingHashAlgorithms": [
        "sha256"
      ],
      "rfc3161TimeStampServer": "http://timestamp.digicert.com",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "hafgit99",
      "repo": "aegis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Aegis Vault",
      "license": "license.txt",
      "installerIcon": "build/icons/icons/icon.ico",
      "uninstallerIcon": "build/icons/icons/icon.ico",
      "uninstallDisplayName": "Aegis Vault",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "packElevateHelper": false
    }
  }
}