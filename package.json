{
  "name": "aegis-vault",
  "version": "2.3.1",
  "type": "module",
  "description": "Premium, Offline-First, Zero-Knowledge Password Manager - Security Hardened Edition (99.8/100 Security Score)",
  "main": "main.js",
  "author": "Aegis Security",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "lint": "eslint . --ext .ts,.tsx,.js",
    "start": "npx electron .",
    "prebuild": "node -e \"const fs = require('fs'); ['dist_out', 'dist_electron_obfuscated', 'dist'].forEach(d => fs.rmSync(d, {recursive: true, force: true}))\"",
    "build": "npm run prebuild && npx vite build && npm run obfuscate && npx electron-builder build --win && npm run postbuild",
    "obfuscate": "node scripts/obfuscate.js",
    "postbuild": "node copy-node-cli.cjs && powershell -ExecutionPolicy Bypass -File scripts/postbuild.ps1",
    "rebuild-native": "electron-rebuild -f -w aegis_security",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:penetration": "vitest run tests/penetration.test.ts",
    "test:memory": "vitest run tests/memory.test.ts",
    "test:timing": "vitest run tests/timing.test.ts",
    "test:fuzz": "vitest run tests/fuzz.test.ts",
    "test:e2e": "vitest run tests/e2e.test.ts",
    "test:integration": "vitest run tests/integration.test.ts",
    "test:performance": "vitest run tests/performance.test.ts",
    "test:emergency": "vitest run tests/emergency.test.ts"
  },
  "dependencies": {
    "@types/papaparse": "5.5.2",
    "@types/qrcode": "1.5.6",
    "better-sqlite3-multiple-ciphers": "12.5.0",
    "dexie": "4.2.1",
    "framer-motion": "11.16.3",
    "googleapis": "^170.0.0",
    "hash-wasm": "4.11.0",
    "html2canvas": "1.4.1",
    "jspdf": "2.5.1",
    "jsqr": "^1.4.0",
    "lucide-react": "0.471.1",
    "papaparse": "5.5.3",
    "qrcode": "1.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "webdav": "^5.8.0",
    "zxcvbn": "4.4.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.1",
    "@testing-library/user-event": "14.6.1",
    "@types/html2canvas": "0.5.35",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react": "5.1.2",
    "@vitest/browser": "4.0.17",
    "@vitest/ui": "4.0.17",
    "autoprefixer": "10.4.23",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "electron-rebuild": "3.2.9",
    "eslint": "^9.39.2",
    "eslint-plugin-security": "^3.0.1",
    "fake-indexeddb": "6.2.5",
    "globals": "^17.3.0",
    "javascript-obfuscator": "^5.1.0",
    "jsdom": "27.4.0",
    "keytar": "7.9.0",
    "node-addon-api": "8.0.0",
    "postcss": "8.5.6",
    "rollup-plugin-javascript-obfuscator": "^1.0.4",
    "sharp": "0.34.5",
    "tailwindcss": "4.1.18",
    "terser": "^5.46.0",
    "vite": "6.4.1",
    "vitest": "4.0.17",
    "webpack-cli": "6.0.1"
  },
  "build": {
    "appId": "com.aegis.vault",
    "productName": "Aegis Vault",
    "copyright": "Copyright © 2026 Aegis Security",
    "directories": {
      "output": "dist_out",
      "buildResources": "assets/build-resources/icons"
    },
    "files": [
      "dist/**/*",
      {
        "from": "dist_electron_obfuscated",
        "to": ".",
        "filter": [
          "main.js",
          "services/**/*"
        ]
      },
      "package.json",
      "browser-extension/**/*"
    ],
    "extraResources": [
      {
        "from": "dist_electron_obfuscated/preload.cjs",
        "to": "preload.cjs"
      },
      "native-host-bridge.cjs",
      "public_key.pem"
    ],
    "extraFiles": [
      {
        "from": "dist_electron_obfuscated/cli.js",
        "to": "cli.js"
      },
      "cli.bat"
    ],
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "icon": "assets/build-resources/icons/app_icon_v2.ico",
      "verifyUpdateCodeSignature": true,
      "signtoolOptions": {
        "publisherName": "Aegis Security",
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com",
        "certificateFile": "build-resources/aegis-cert.pfx",
        "certificatePassword": "AegisVault2024!"
      },
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "hafgit99",
      "repo": "aegis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Aegis Vault",
      "license": "license.txt",
      "installerIcon": "assets/build-resources/icons/app_icon_v2.ico",
      "uninstallerIcon": "assets/build-resources/icons/app_icon_v2.ico",
      "uninstallDisplayName": "Aegis Vault",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "packElevateHelper": false
    }
  }
}