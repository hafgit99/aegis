{
  "name": "aegis-vault",
  "version": "2.0.1",
  "type": "module",
  "description": "Premium, Offline-First, Zero-Knowledge Password Manager - Security Hardened Edition",
  "main": "main.js",
  "author": "Aegis Security",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "start": "npx electron .",
    "build": "npx vite build && npm run obfuscate && npx electron-builder build --win",
    "obfuscate": "node scripts/obfuscate.js",
    "postbuild": "node copy-node-cli.cjs && powershell -Command \"$out = 'dist_out'; if (Test-Path $out) { Remove-Item -Path (Join-Path $out 'SHA256SUMS.txt') -ErrorAction SilentlyContinue; Get-ChildItem -Path $out -Filter '*.zip' | ForEach-Object { $hash = (Get-FileHash $_.FullName -Algorithm SHA256).Hash; \\\"$hash  $($_.Name)\\\" | Out-File (Join-Path $out 'SHA256SUMS.txt') -Append -Encoding utf8; Write-Host \\\"[Security] Checksum created for $($_.Name)\\\" } }\"",
    "rebuild-native": "electron-rebuild -f -w aegis_security",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@types/papaparse": "5.5.2",
    "@types/qrcode": "1.5.6",
    "better-sqlite3-multiple-ciphers": "12.5.0",
    "dexie": "4.2.1",
    "framer-motion": "11.16.3",
    "hash-wasm": "4.11.0",
    "html2canvas": "1.4.1",
    "jspdf": "2.5.1",
    "lucide-react": "0.471.1",
    "papaparse": "5.5.3",
    "qrcode": "1.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zxcvbn": "4.4.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.1",
    "@testing-library/user-event": "14.6.1",
    "@types/html2canvas": "0.5.35",
    "@vitejs/plugin-react": "5.1.2",
    "@vitest/browser": "4.0.17",
    "@vitest/ui": "4.0.17",
    "autoprefixer": "10.4.23",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "electron-rebuild": "3.2.9",
    "fake-indexeddb": "6.2.5",
    "javascript-obfuscator": "^5.1.0",
    "jsdom": "27.4.0",
    "keytar": "7.9.0",
    "node-addon-api": "8.0.0",
    "postcss": "8.5.6",
    "rollup-plugin-javascript-obfuscator": "^1.0.4",
    "sharp": "0.34.5",
    "tailwindcss": "4.1.18",
    "vite": "6.4.1",
    "vitest": "4.0.17",
    "webpack-cli": "6.0.1"
  },
  "build": {
    "appId": "com.aegis.vault",
    "productName": "Aegis Vault",
    "copyright": "Copyright © 2024 Aegis Security",
    "directories": {
      "output": "dist_out",
      "buildResources": "assets/build-resources/icons"
    },
    "files": [
      "dist/**/*",
      {
        "from": "dist_electron_obfuscated",
        "to": ".",
        "filter": [
          "main.js",
          "services/**/*"
        ]
      },
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist_electron_obfuscated/preload.cjs",
        "to": "preload.cjs"
      }
    ],
    "extraFiles": [
      {
        "from": "dist_electron_obfuscated/cli.js",
        "to": "cli.js"
      },
      "cli.bat"
    ],
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "icon": "assets/build-resources/icons/app_icon_v2.ico",
      "publisherName": "Aegis Security",
      "verifyUpdateCodeSignature": true,
      "forceCodeSigning": false,
      "certificateFile": null,
      "certificatePassword": null,
      "signingHashAlgorithms": [
        "sha256"
      ],
      "rfc3161TimeStampServer": "http://timestamp.digicert.com",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "hafgit99",
      "repo": "aegis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Aegis Vault",
      "license": "license.txt",
      "installerIcon": "assets/build-resources/icons/app_icon_v2.ico",
      "uninstallerIcon": "assets/build-resources/icons/app_icon_v2.ico",
      "uninstallDisplayName": "Aegis Vault",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "packElevateHelper": false
    }
  }
}