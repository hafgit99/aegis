{
    "key": "",
    "name": "Aegis Vault",
    "version": "1.0.2",
    "manifest_version": 3,
    "description": "Secure bridge for Aegis Vault",
    "permissions": [
        "nativeMessaging",
        "activeTab",
        "scripting"
    ],
    "optional_host_permissions": [
        "https://*/*"
    ],
    "content_security_policy": {
        "extension_pages": "default-src 'self'; connect-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https://secure.gravatar.com; object-src 'none'; base-uri 'self'; form-action 'self';"
    },
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "icons": {
        "16": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "icon.png"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}