{
    "compilerOptions": {
        "target": "ES2020",
        "useDefineForClassFields": true,
        "lib": [
            "ES2020",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "ESNext",
        "skipLibCheck": true,
        /* Bundler mode */
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx",
        /* Linting */
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        /* Path mapping */
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "@components/*": [
                "./src/renderer/components/*"
            ],
            "@hooks/*": [
                "./src/renderer/hooks/*"
            ],
            "@store/*": [
                "./src/renderer/store/*"
            ],
            "@services/*": [
                "./src/renderer/services/*"
            ],
            "@utils/*": [
                "./src/renderer/utils/*"
            ]
        }
    },
    "include": [
        "src/renderer",
        "src/types",
        "vite.config.ts"
    ]
}